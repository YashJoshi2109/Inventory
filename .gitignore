# ─── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Python ───────────────────────────────────────────────────────────────────
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/*.egg-info/
backend/.pytest_cache/
backend/uploads/

# ─── HVAC Collector ───────────────────────────────────────────────────────────
hvac_collector/.venv/
hvac_collector/__pycache__/
# Git has no trailing comments: a "# ..." after a pattern becomes part of the
# pattern, so these two lines previously matched nothing. Comments go on their own line.
# Local CSV backups (already-tracked CSVs stay tracked until `git rm --cached`):
hvac_collector/*.csv
# OAuth tokens (sensitive):
hvac_collector/tokens.json

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ─── Playwright MCP (browser console/network captures — may contain 3rd-party keys) ──
.playwright-mcp/

# ─── Superpowers brainstorm visual companion artifacts ────────────────────────
.superpowers/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ──────────────────────────────────────────────────────────────────────
.cursor/
*.swp
*.swo
.env*.local

# ─── CI build artefacts downloaded for testing ───────────────────────────────
# `gh run download` drops the Windows package here; it is 20 MB of binary that
# the Windows job rebuilds on every push.
InventoryLedger-windows*.zip

# ─── Other teams' submissions ─────────────────────────────────────────────────
# Final_Submission_HVAC_Dashboard.zip carries that team's .env files. Never commit it.
Final_Submission_*.zip

# ─── Python bytecode anywhere (the three root .pyc were untracked with `git rm --cached`) ─
__pycache__/
*.py[cod]

# ─── Professor reference drop (2026-07 Prof Lab Code.zip) ────────────────────
# 37MB of external reference material: spec docs, baseline reference impl,
# bundled Windows Python runtime, meeting packets. Read-only context, not our code.
Lab Code/
